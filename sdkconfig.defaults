# --- Console -------------------------------------------------------------
# This is a classic ESP32, which has NO native USB peripheral - the only
# console path is UART0 via the CH340/CP210x bridge (/dev/ttyUSB0).
# (The USB Serial/JTAG secondary console that an S3 would use is deliberately
# absent here; it does not exist on this chip.)
# NOTE: ESP_CONSOLE_UART_BAUDRATE is declared in IDF as
#     prompt "UART console baud rate" if ESP_CONSOLE_UART_CUSTOM
# so with the *_DEFAULT console choice the symbol has no prompt, is not
# user-settable, and any value set here is silently discarded in favour of
# its 115200 default. Selecting _CUSTOM enables the prompt so the baud below
# actually takes effect. The GPIOs are just ESP32 UART0's normal pins, so
# this is the same physical port, only with a settable rate.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# 115200 is not enough headroom. A busy room can produce >100 probe frames/s;
# at ~120 bytes of JSON each that is ~120 kbps, which overruns 115200 (11.5 KB/s)
# and the driver starts dropping. 921600 gives ~92 KB/s of margin.

# --- Logging -------------------------------------------------------------
# Keep the IDF's own chatter off the wire; it shares stdout with our JSON.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# --- WiFi / promiscuous --------------------------------------------------
# Promiscuous capture hands us every frame on the channel, so give the driver
# more RX buffers than the default or bursts get dropped inside the driver
# before our callback ever runs.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# --- Perf ----------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# NOTE: PSRAM is deliberately NOT enabled. Many S3 boards have none, and
# turning it on for a board without it can hang at boot. We don't need it.
